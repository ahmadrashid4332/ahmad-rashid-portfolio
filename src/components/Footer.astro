---
import { Icon } from 'astro-icon/components';
import ThemeToggle from './ThemeToggle.astro';
import { NAME } from '../lib/site-config';

/*
 * One row above a hairline. Compact, quiet.
 *
 * No build numbers, no version strings, no locale or time strip, and no stack
 * credit (that option was closed: omitted).
 *
 * Carries the SECOND theme toggle. The nav is static, so once a visitor scrolls
 * past it the nav toggle is gone, and someone at the bottom wanting the other
 * theme would otherwise have to scroll the whole page back up. Same control,
 * same label, same state, not a competing one.
 */
interface Props {
	githubUrl: string;
	linkedinUrl: string;
}

const { githubUrl, linkedinUrl } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container footer-inner">
		<ul class="socials">
			<li>
				<a href={githubUrl} target="_blank" rel="noopener noreferrer">
					<span class="glyph" aria-hidden="true"><Icon name="ph:github-logo" /></span>
					GitHub
					<span class="visually-hidden">, opens in a new tab</span>
				</a>
			</li>
			<li>
				<a href={linkedinUrl} target="_blank" rel="noopener noreferrer">
					<span class="glyph" aria-hidden="true"><Icon name="ph:linkedin-logo" /></span>
					LinkedIn
					<span class="visually-hidden">, opens in a new tab</span>
				</a>
			</li>
		</ul>

		<div class="end">
			<p class="copyright">&copy; {year} {NAME}</p>
			<ThemeToggle />
		</div>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--line);
	}

	.footer-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		padding-block: var(--space-6);
	}

	.socials {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.socials a {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		min-height: var(--target-min);
		padding-inline: var(--space-3);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		/* Brand icons take --text-muted, never their brand colours. The footer
		 * does not get a blue GitHub button: one accent for the whole page. */
		color: var(--text-muted);
		font-size: var(--size-meta);
		font-weight: var(--weight-medium);
		text-decoration: none;
		transition:
			color var(--duration-hover) var(--ease-out),
			border-color var(--duration-hover) var(--ease-out);
	}

	.socials a:hover {
		color: var(--text);
		border-color: var(--text-muted);
	}

	.glyph {
		display: inline-flex;
		font-size: 1.125rem;
		line-height: 0;
	}

	.end {
		display: flex;
		align-items: center;
		gap: var(--space-4);
	}

	.copyright {
		color: var(--text-muted);
		font-size: var(--size-meta);
	}
</style>
