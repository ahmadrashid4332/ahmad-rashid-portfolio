---
/*
 * One tag component, used by both the Skills section and the project tech
 * lists. Not two components that happen to look alike (design.md section 5.6).
 *
 * Non-interactive, so there is no hover state and no 44px target requirement.
 */
interface Props {
	label: string;
}

const { label } = Astro.props;
---

<li class="tag">{label}</li>

<style>
	.tag {
		display: inline-flex;
		align-items: center;
		padding: var(--space-2) var(--space-3);
		border-radius: var(--radius);
		background-color: var(--bg-subtle);
		/*
		 * At 13px this is small text, so it must clear 4.5:1 rather than the
		 * 3:1 large-text allowance. --text-muted on --bg-subtle measures
		 * 6.85:1 light and 7.05:1 dark (design.md section 3.1).
		 */
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: var(--size-tag);
		font-weight: var(--weight-medium);
		letter-spacing: var(--track-tag);
		line-height: var(--leading-tag);
		/* No border. The fill alone separates it from body text. */

		/*
		 * "anywhere", not "break-word", and the difference is the whole point.
		 *
		 * Both permit a break inside a long token, but only "anywhere" also
		 * shrinks the element's min-content width. Under "break-word" the grid
		 * track keeps sizing itself to the longest unbreakable token, so nothing
		 * is ever forced to wrap and the page widens instead.
		 *
		 * Measured at 320px: a tag survived to roughly 34 unbroken characters
		 * and pushed the page wide from roughly 38, dragging the skills row and
		 * the hero sentence out with it. No real tag is that long, but the tag
		 * list is CMS-editable from a phone, so the ceiling was reachable by
		 * typing. min-width: 0 closes the same failure through the flex parent.
		 */
		min-width: 0;
		overflow-wrap: anywhere;
	}
</style>
