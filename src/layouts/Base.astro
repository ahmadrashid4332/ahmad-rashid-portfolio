---
import '../styles/tokens.css';
import '../styles/base.css';
import { NAME, EMAIL } from '../lib/site-config';
import { getSite } from '../lib/content';

interface Props {
	title: string;
	description: string;
	/** Omit on pages that should not be indexed or shared, such as 404. */
	shareable?: boolean;
}

const { title, description, shareable = true } = Astro.props;

// lang on <html> is WCAG 2.2 SC 3.1.1, Level A. It tells a screen reader which
// pronunciation rules to use. spec.md section 4.2. Kept as a frontmatter note
// rather than an HTML comment so it does not ship to every visitor.

/*
 * Every absolute URL derives from Astro.site, which is set once in
 * astro.config.mjs. Nothing here hardcodes a domain.
 *
 * That is what makes the move to a custom domain a one-line change instead of a
 * sweep through every tag, and it is why the canonical and the OG image URL
 * cannot drift apart from each other.
 */
const canonical = new URL(Astro.url.pathname, Astro.site);

// Relative OG image URLs simply fail to unfurl. This one is absolute.
const ogImage = new URL('/og-image.png', Astro.site);

const site = await getSite();

/*
 * JSON-LD Person.
 *
 * sameAs points at the two profiles. There is deliberately NO address,
 * telephone or image property: those would reintroduce exactly the personal
 * details the site excludes everywhere else, and structured data is not a
 * loophole in that rule.
 */
const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: NAME,
	url: Astro.site?.toString(),
	email: `mailto:${EMAIL}`,
	jobTitle: 'Web Developer',
	sameAs: [site.githubUrl, site.linkedinUrl],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		{/* Scalable, and the one favicon format that can follow the viewer's
		    theme. The 32px PNG covers engines that ignore SVG favicons. */}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

		{
			shareable && (
				<>
					<meta property="og:type" content="website" />
					<meta property="og:title" content={title} />
					<meta property="og:description" content={description} />
					<meta property="og:url" content={canonical} />
					<meta property="og:image" content={ogImage} />
					<meta property="og:image:width" content="1200" />
					<meta property="og:image:height" content="630" />
					<meta property="og:locale" content="en" />
					<meta name="twitter:card" content="summary_large_image" />
					<meta name="twitter:title" content={title} />
					<meta name="twitter:description" content={description} />
					<meta name="twitter:image" content={ogImage} />
				</>
			)
		}

		{!shareable && <meta name="robots" content="noindex" />}

		<script
			type="application/ld+json"
			set:html={JSON.stringify(personSchema)}
		/>

		{/*
			Anti-flash script. Synchronous, inline, and in <head> before any
			stylesheet renders. This is deliberately render-blocking and is one
			of the few legitimate uses (research.md section 3).

			It must stay inline and tiny. Moving it to an external file would
			defeat the purpose, because the fetch would happen after first paint.

			Every localStorage access is wrapped, because private browsing can
			throw on both read and write. An uncaught exception here is a white
			page, not a degraded one: the script blocks rendering.

			The stored value is validated against the two known strings rather
			than trusted, so a corrupt or hand-edited value falls back to the
			system preference instead of stamping garbage onto the element.

			The attribute is stamped ONLY when a valid stored preference exists.
			With no override, no attribute is written and the media query in
			tokens.css does the work, which is what makes the site follow a
			change to the OS theme while the page is open (spec.md section 5.1).
			Stamping unconditionally would pin the theme at first paint and
			silently break that case.
		*/}
		<script is:inline>
			(function () {
				try {
					var stored = localStorage.getItem('theme');
					if (stored === 'dark' || stored === 'light') {
						document.documentElement.setAttribute('data-theme', stored);
					}
				} catch (e) {}
			})();
		</script>

		{/*
			Vercel Web Analytics. The only analytics provider on the site, and
			the only third-party script.

			Loaded by path rather than through a package, so it adds no
			dependency and no build step. It is served by Vercel itself once
			Analytics is enabled for the project, and it 404s harmlessly
			everywhere else, including local development.
		*/}
		<script defer src="/_vercel/insights/script.js"></script>

		{/*
			With JavaScript disabled the theme toggle and the copy control are
			hidden rather than left as visible controls that silently do nothing
			(spec.md section 5.1, design.md section 6). Everything else is
			identical: the site renders fully in the system-preferred theme.
		*/}
		<noscript>
			<style>
				[data-requires-js] {
					display: none !important;
				}
			</style>
		</noscript>
	</head>
	<body>
		<slot />
	</body>
</html>
