---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Skills from '../components/Skills.astro';
import Projects from '../components/Projects.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { getProjects, getSite, getSkills } from '../lib/content';
import { SEO_TITLE, SEO_DESCRIPTION } from '../lib/site-config';

/*
 * Composes section components in display order and holds no content of its own.
 *
 * That separation is what makes "adding a project is one entry, never a markup
 * edit" true: everything below reads from the content layer, so the CMS can add,
 * remove and reorder entries without anyone opening this file.
 */
const site = await getSite();
const projects = await getProjects();
const skills = await getSkills();
---

<Base title={SEO_TITLE} description={SEO_DESCRIPTION}>
	<Nav />
	<main>
		<Hero sentence={site.heroSentence} />
		<About text={site.about} />
		<Skills groups={skills} />
		<Projects projects={projects} />
		<Contact />
	</main>
	<Footer githubUrl={site.githubUrl} linkedinUrl={site.linkedinUrl} />
</Base>
